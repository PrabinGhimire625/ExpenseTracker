@page "/"
@using ExpenseTracker.Components.Layout
@layout FirstLayout

<section class="bg-light min-vh-100 d-flex justify-content-center align-items-center">
    <div class="text-center p-5 rounded shadow-lg bg-white" style="width: 400px; border-radius: 20px;">
        <!-- Logo -->
        <div class="d-flex justify-content-center mb-3">
            <img src="logo.png" alt="Logo" class="rounded-circle" style="width: 100px; height: 100px; object-fit: cover;" />
        </div>

        <!-- Header -->
        <h1 class="mb-3 text-primary" style="font-size: 2.5rem; font-weight: 700;">Expense Tracker</h1>
        <p class="text-muted mb-4" style="font-size: 1.1rem;">Track your expenses effortlessly and stay on top of your finances.</p>

        <!-- Buttons for Login and Register -->
        <div class="d-grid gap-3">
            <a href="/login" class="btn btn-primary btn-lg" style="font-size: 1.2rem; font-weight: 600;">Login</a>
            <a href="/register" class="btn btn-outline-secondary btn-lg" style="font-size: 1.2rem; font-weight: 600;">Register</a>
        </div>
    </div>
</section>

@code {

}
