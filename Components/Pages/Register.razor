@page "/register"
@using ExpenseTracker.Components.Layout
@layout FirstLayout
@using ExpenseTracker.Models
@inject UserService UserService
@inject NavigationManager NavigationManager

<section class="bg-light">
    <div class="d-flex justify-content-center align-items-center min-vh-100">
        <div class="card shadow-lg border-0 p-4" style="width: 400px; border-radius: 16px;">
            <div class="d-flex justify-content-center mb-4">
                <img src="logo.png" alt="Logo" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;" />
            </div>

            <h2 class="text-center mb-4">Signup</h2>

            <form @onsubmit="OnRegister">
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="Username" style="font-weight: 300;" @bind="RegisterUsername" required>
                </div>

                <div class="mb-3">
                    <input type="email" class="form-control" placeholder="email" style="font-weight: 300;" @bind="RegisterEmail" required>
                </div>

                <div class="mb-3">
                    <input type="password" class="form-control" placeholder="password" style="font-weight: 300;" @bind="RegisterPassword" required>
                </div>

                <div class="mb-4">
                    <select class="form-select" style="font-weight: 300;" @bind="RegisterCurrency" required>
                        <option value="" disabled selected>currency</option>    
                        <option value="NPR">NPR</option>
                        <option value="USD">USD</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mb-3">Sign up</button>
            </form>

            @if (!string.IsNullOrEmpty(Message))
            {
                    <p class="text-center @(Message == "Registration successful" ? "text-success" : "text-muted")">@Message</p>
            }

            <div class="text-center mt-2">
                <p class="mb-0">Already have an account? <a href="/login" class="text-primary text-decoration-none">Sign in here</a></p>
            </div>
        </div>
    </div>
</section>

@code {
    private string RegisterUsername = ""; // New field for username
    private string RegisterEmail = "";
    private string RegisterPassword = "";
    private string RegisterCurrency = "";
    private string Message = "";
    private List<User> Users = new();

    protected override void OnInitialized()
    {
        Users = UserService.LoadUsers();
    }

    private async Task OnRegister()
    {
        if (string.IsNullOrWhiteSpace(RegisterUsername) || string.IsNullOrWhiteSpace(RegisterEmail) || string.IsNullOrWhiteSpace(RegisterPassword) || string.IsNullOrWhiteSpace(RegisterCurrency))
        {
            Message = "All fields are required.";
            return;
        }

        if (Users.Any(u => u.Email == RegisterEmail))
        {
            Message = "Email already exists.";
            return;
        }

        // Generate a unique ID for the new user
        var newUserId = Users.Any() ? Users.Max(u => u.Id) + 1 : 1;  // If there are users, take the max ID and increment by 1, else start from 1.

        var newUser = new User
            {
                Id = newUserId,
                Username = RegisterUsername,
                Email = RegisterEmail,
                Password = UserService.HashPassword(RegisterPassword),
                Currency = RegisterCurrency
            };

        Users.Add(newUser);
        UserService.SaveUsers(Users);
        Message = "Registration successful";
        await Task.Delay(2000);
        NavigationManager.NavigateTo("/login");
    }
}
