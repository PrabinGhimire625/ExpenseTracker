@page "/dashboard"
@using System.Text
@using ExpenseTracker.Models
@inject NavigationManager NavigationManager
@inject TransactionService TransactionService
@inject DebtService DebtService
@inject IJSRuntime JSRuntime
@using OfficeOpenXml
@inject FileDownloadService FileDownloadService
@inject CurrencyService CurrencyService

<div class="main-content container py-4" style="color: white;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 style="font-weight: bold;">Dashboard</h1>
        <div class="d-flex align-items-center">
            <select class="form-select" style="font-weight: 300;" name="RegisterCurrency" @onchange="OnCurrencyChange">
                <option value="" disabled selected>Select currency</option>
                <option value="USD">USD</option>
                <option value="NPR">NPR</option>
            </select>

            <a href="/login">
                <button class="btn btn-success ms-3">Logout</button>
            </a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3">
        <div class="col-md-3">
            <div class="card text-center bg-dark text-white shadow-sm">
                <div class="card-body">
                    <h6>Total Net Worth</h6>
                    <p class="display-6 text-danger"> @CurrencyService.SelectedCurrencySymbol @TotalNetWorth</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center bg-dark text-white shadow-sm">
                <div class="card-body">
                    <h6>Total Income</h6>
                    <p class="display-6 text-success">@CurrencyService.SelectedCurrencySymbol @TotalIncome</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center bg-dark text-white shadow-sm">
                <div class="card-body">
                    <h6>Total Expenses</h6>
                    <p class="display-6 text-warning">@CurrencyService.SelectedCurrencySymbol @TotalExpenses</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center bg-dark text-white shadow-sm">
                <div class="card-body p-3">
                    <h5 class="card-title text-danger">Transaction overview</h5>
                    <p class="card-text">
                        <strong>No of transaction:</strong> @TotalTransactions
                    </p>
                    <p class="card-text">
                        <strong>Total-transaction:</strong>@CurrencyService.SelectedCurrencySymbol @TotalTransactionsCalculatedAmount
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center bg-dark text-white shadow-sm">
                <div class="card-body p-4">
                    <h5 class="card-title text-warning">Inflow/Outflow Overview</h5>
                    <p class="card-text">
                        <strong>Highest Inflow:</strong> @CurrencyService.SelectedCurrencySymbol @HighestInflowAmount
                    </p>
                    <p class="card-text">
                        <strong>Lowest Inflow:</strong> @CurrencyService.SelectedCurrencySymbol @LowestInflowAmount
                    </p>
                    <p class="card-text">
                        <strong>Highest Outflow:</strong> @CurrencyService.SelectedCurrencySymbol @HighestOutflowAmount
                    </p>
                    <p class="card-text">
                        <strong>Lowest Outflow:</strong> @CurrencyService.SelectedCurrencySymbol @LowestOutflowAmount
                    </p>
                </div>
            </div>
        </div>


        <div class="col-md-3 mb-2">
            <div class="card text-center bg-dark text-white shadow-sm">
                <div class="card-body p-4">
                    <h5 class="card-title text-success">Debts Overview</h5>
                    <p class="card-text">
                        <strong>Total Debts:</strong>@CurrencyService.SelectedCurrencySymbol @TotalDebt
                    </p>
                    <p class="card-text">
                        <strong>Cleared Debts:</strong>@CurrencyService.SelectedCurrencySymbol @ClearedDebt
                    </p>
                    <p class="card-text">
                        <strong>Remaining Debts:</strong> @CurrencyService.SelectedCurrencySymbol @RemainingDebt
                    </p>
                    <p class="card-text">
                        <strong>Highest Debts:</strong>@CurrencyService.SelectedCurrencySymbol @HighestDebtAmount
                    </p>
                    <p class="card-text">
                        <strong>Lowest Debts:</strong>@CurrencyService.SelectedCurrencySymbol @LowestDebtAmount
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Debts Section -->
    <div class=" p-2 mb-3" style="background-color: black;">
        <h3 class="text-white font-weight-bold" style="font-size: 2rem;">Pending Debts</h3>
        <table class="table table-dark table-hover">
            <thead>
                <tr>
                    <th>Source</th>
                    <th>Type</th>
                    <th>Total Amount</th>
                    <th>Remaining Amount</th>
                    <th>Due Date</th>
                </tr>
            </thead>
            <tbody>
                @if (PendingDebts != null && PendingDebts.Any())
                {
                    @foreach (var debt in PendingDebts)
                    {
                        <tr>
                            <td>@debt.Source</td>
                            <td>@debt.Type</td>
                            <td>@debt.Amount</td>
                            <td>@debt.RemainigAmount</td>
                            <td>@debt.DueDate</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No pending debts available.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Transactions Section -->
    <div class="row p-2 mb-3" style="background-color: black;">
        <!-- Highest Transactions Section (Left) -->
        <div class="col-md-6">
            <h3 class="text-white font-weight-bold" style="font-size: 2rem;">Top 5 Highest Transactions</h3>
            <table class="table table-dark table-hover">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Amount</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Top5HighestTransactions != null && Top5HighestTransactions.Any())
                    {
                        @foreach (var transaction in Top5HighestTransactions)
                        {
                            <tr>
                                <td>@transaction.Title</td>
                                <td>@transaction.Amount</td>
                                <td>@transaction.Date.ToShortDateString()</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center">No transactions available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Lowest Transactions Section (Right) -->
        <div class="col-md-6">
            <h3 class="text-white font-weight-bold" style="font-size: 2rem;">Top 5 Lowest Transactions</h3>
            <table class="table table-dark table-hover">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Amount</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Top5LowestTransactions != null && Top5LowestTransactions.Any())
                    {
                        @foreach (var transaction in Top5LowestTransactions)
                        {
                            <tr>
                                <td>@transaction.Title</td>
                                <td>@transaction.Amount</td>
                                <td>@transaction.Date.ToShortDateString()</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center">No transactions available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Transactions Section -->
    <!-- Transactions Section -->
    <div class="row p-2 mb-3" style="background-color: black;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <!-- Date Filter Section (Left Side) -->
            <div class="d-flex mt-4">
                <input type="date" @bind="StartDate" class="form-control d-inline-block w-auto me-2" />
                <input type="date" @bind="EndDate" class="form-control d-inline-block w-auto me-2" />
                <button class="btn btn-primary" @onclick="FilterByDateRange">Filter</button>
                <button class="btn btn-primary ml-3" @onclick="DownloadTransactions">Download Transaction</button>
            </div>

            <!-- Sort Button Section (Right Side) -->
            <div>
                <button class="btn btn-primary" @onclick="ToggleSortOrder">
                    Sort: @(IsAscending ? "Ascending" : "Descending")
                </button>
            </div>
        </div>

        <h3 class="text-white font-weight-bold" style="font-size: 2rem;">Display Transactions</h3>
        <table class="table table-dark table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredTransactions != null && FilteredTransactions.Any())
                {
                    @foreach (var transaction in FilteredTransactions)
                    {
                        <tr>
                            <td>@transaction.Title</td>
                            <td>@transaction.Type</td>
                            <td>@transaction.Amount</td>
                            <td>@transaction.Date.ToShortDateString()</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">No transactions available.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrEmpty(downloadMessage))
    {
        <div class="alert alert-info mt-3" role="alert">
            @downloadMessage
        </div>
    }

</div>
@code {
    private decimal TotalIncome = 0;
    private decimal TotalExpenses = 0;
    private decimal TotalNetWorth = 0;
    private decimal TotalDebt = 0;
    private decimal ClearedDebt = 0;
    private decimal RemainingDebt = 0;
    private int TotalTransactions = 0;
    private decimal TotalTransactionsCalculated = 0;

    private List<TransactionModel> Transactions = new();
    private List<TransactionModel> FilteredTransactions = new();
    private bool IsAscending = true;
    private DateTime? StartDate;
    private DateTime? EndDate;

    private TransactionModel HighestInflow;
    private TransactionModel LowestInflow;
    private TransactionModel HighestOutflow;
    private TransactionModel LowestOutflow;

    private decimal HighestInflowAmount = 0;
    private decimal LowestInflowAmount = 0;
    private decimal HighestOutflowAmount = 0;
    private decimal LowestOutflowAmount = 0;

    private DebtModel HighestDebt;
    private DebtModel LowestDebt;

    private decimal HighestDebtAmount = 0;
    private decimal LowestDebtAmount = 0;

    private List<DebtModel> PendingDebts = new();
    private List<TransactionModel> Top5Transactions = new();
    private List<TransactionModel> Top5HighestTransactions = new();
    private List<TransactionModel> Top5LowestTransactions = new();

    // Added NPR values (default currency)
    private decimal TotalIncomeNPR = 0;
    private decimal TotalExpensesNPR = 0;
    private decimal TotalNetWorthNPR = 0;
    private decimal TotalDebtNPR = 0;
    private decimal ClearedDebtNPR = 0;
    private decimal RemainingDebtNPR = 0;
    private decimal HighestInflowNPR = 0;
    private decimal LowestInflowNPR = 0;
    private decimal HighestOutflowNPR = 0;
    private decimal LowestOutflowNPR = 0;
    private decimal HighestDebtNPR = 0;
    private decimal LowestDebtNPR = 0;
    private decimal TotalTransactionsCalculatedNPR = 0;

    private decimal TotalTransactionsCalculatedAmount = 0;

    private string downloadMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userId = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");

            if (string.IsNullOrEmpty(userId))
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            var id = int.Parse(userId);

            // Store all values in NPR by default
            TotalIncomeNPR = TransactionService.CalculateTotalIncome(id);
            TotalExpensesNPR = TransactionService.CalculateTotalExpenses(id);
            TotalNetWorthNPR = TotalIncomeNPR - TotalExpensesNPR;

            // Fetch transactions
            Transactions = TransactionService.GetUserTransactions(id);
            FilteredTransactions = SortTransactionsByDate(Transactions, IsAscending);
            TotalTransactions = Transactions.Count;

            // Top 5 transactions by amount
            Top5Transactions = Transactions.OrderByDescending(t => t.Amount).Take(5).ToList();
            Top5HighestTransactions = await TransactionService.GetTop5HighestTransactions(id);
            Top5LowestTransactions = await TransactionService.GetTop5LowestTransactions(id);

            // Calculate debt information
            TotalDebtNPR = DebtService.CalculateTotalDebt(id);
            ClearedDebtNPR = DebtService.CalculateClearedDebt(id);
            RemainingDebtNPR = DebtService.CalculateRemainingDebt(id);

            // Fetch highest and lowest transactions in NPR
            HighestInflowNPR = TransactionService.GetHighestIncome(id)?.Amount ?? 0;
            LowestInflowNPR = TransactionService.GetLowestIncome(id)?.Amount ?? 0;
            HighestOutflowNPR = TransactionService.GetHighestExpense(id)?.Amount ?? 0;
            LowestOutflowNPR = TransactionService.GetLowestExpense(id)?.Amount ?? 0;

            // Fetch highest and lowest debts
            HighestDebt = DebtService.GetHighestDebt(id);
            LowestDebt = DebtService.GetLowestDebt(id);

            HighestDebtNPR = HighestDebt?.Amount ?? 0;
            LowestDebtNPR = LowestDebt?.Amount ?? 0;

            // Fetch pending debts
            PendingDebts = DebtService.GetPendingDebts(id);

            // Calculate total transactions based on inflows, debts, and outflows
            TotalTransactionsCalculatedNPR = TotalIncomeNPR + TotalDebtNPR - TotalExpensesNPR;

            // Recalculate the displayed financials with the selected currency
            UpdateFinancialData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private List<TransactionModel> SortTransactionsByDate(List<TransactionModel> transactions, bool ascending)
    {
        return ascending
            ? transactions.OrderBy(t => t.Date).ToList()
            : transactions.OrderByDescending(t => t.Date).ToList();
    }

    private void ToggleSortOrder()
    {
        IsAscending = !IsAscending;
        FilteredTransactions = SortTransactionsByDate(Transactions, IsAscending);
    }

    private void FilterByDateRange()
    {
        if (StartDate.HasValue && EndDate.HasValue)
        {
            FilteredTransactions = Transactions.Where(t => t.Date >= StartDate.Value && t.Date <= EndDate.Value).ToList();
        }
    }

    private void OnCurrencyChange(ChangeEventArgs e)
    {
        CurrencyService.SetCurrency(e.Value.ToString());
        UpdateFinancialData();
    }

    private void UpdateFinancialData()
    {
        // Convert NPR amounts to the selected currency and round to 1 decimal place
        var conversionRate = CurrencyService.GetConversionRate(CurrencyService.SelectedCurrency);

        TotalIncome = Math.Round(TotalIncomeNPR * conversionRate, 1);
        TotalExpenses = Math.Round(TotalExpensesNPR * conversionRate, 1);
        TotalNetWorth = Math.Round(TotalNetWorthNPR * conversionRate, 1);
        TotalDebt = Math.Round(TotalDebtNPR * conversionRate, 1);
        ClearedDebt = Math.Round(ClearedDebtNPR * conversionRate, 1);
        RemainingDebt = Math.Round(RemainingDebtNPR * conversionRate, 1);

        HighestInflowAmount = Math.Round(HighestInflowNPR * conversionRate, 1);
        LowestInflowAmount = Math.Round(LowestInflowNPR * conversionRate, 1);
        HighestOutflowAmount = Math.Round(HighestOutflowNPR * conversionRate, 1);
        LowestOutflowAmount = Math.Round(LowestOutflowNPR * conversionRate, 1);

        HighestDebtAmount = Math.Round(HighestDebtNPR * conversionRate, 1);
        LowestDebtAmount = Math.Round(LowestDebtNPR * conversionRate, 1);

        TotalTransactionsCalculatedAmount = Math.Round(TotalTransactionsCalculatedNPR * conversionRate, 1);
    }

    private async Task DownloadTransactions()
    {
        try
        {
            // Filter transactions by the selected date range
            var filteredTransactions = Transactions.Where(t =>
                (!StartDate.HasValue || t.Date >= StartDate.Value) &&
                (!EndDate.HasValue || t.Date <= EndDate.Value)).ToList();

            // Generate file content
            var fileBytes = FileDownloadService.GenerateTransactionFile(filteredTransactions);

            // Convert to Base64 for JavaScript download
            var base64File = Convert.ToBase64String(fileBytes);
            var fileName = "Transactions.txt";

            // Trigger the download via JSInterop
            await JSRuntime.InvokeVoidAsync("saveAsFile", fileName, base64File);

            // Update message on successful download
            downloadMessage = "Transactions downloaded successfully!";
        }
        catch (Exception ex)
        {
            // Update message on failure
            downloadMessage = $"Error during download: {ex.Message}";
        }
    }

}
